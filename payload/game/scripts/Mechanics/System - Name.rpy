                                elif hero_about_3rdy == "lname":
                                    text renpy.translate_string('[C_Drk]{i}Called "{b}Mrs. ') + getattr(store, f"lname{a_check_5}") + '{/b}"{/i}[C_Off]' size 40

                                elif hero_about_3rdy == "senpai":
                                    text renpy.translate_string('[C_Drk]{i}Called "{b}Senpai{/b}"{/i}[C_Off]') size 40

                                elif hero_about_3rdy == "fname-senpai":
                                    text renpy.translate_string('[C_Drk]{i}Called "{b}') + getattr(store, f"fname{a_check_5}") + '-senpai{/b}"{/i}[C_Off]' size 40

                                elif hero_about_3rdy == "lname-senpai":
                                    text renpy.translate_string('[C_Drk]{i}Called "{b}') + getattr(store, f"lname{a_check_5}") + '-senpai{/b}"{/i}[C_Off]' size 40

                                else:
                                    text renpy.translate_string("[C_Drk]{i}Called by whatever it's decided in game{/i}[C_Off]") size 40
                    else:
                        hbox:
                            xalign 0.5
                            text renpy.translate_string("{size=40}[C_Drk]Select a character[C_Off]{/size}")
                    hbox:
                        xalign 0.5
                        text renpy.translate_string("{size=40}{pr}{/size}")

            vbar value YScrollValue("ScrollStudentName")

    hbox:
        xalign 1.0
        yalign 1.0
        xoffset -25
        yoffset -25
        imagebutton:
            idle At("images/UI/QUICK_Arrow_6.webp", ButtonIdle)
            hover At("images/UI/QUICK_Arrow_6.webp", ButtonHover)
            action [SetVariable("a_check_6", 1), Jump("schoolday_1_1_skip")]

return
