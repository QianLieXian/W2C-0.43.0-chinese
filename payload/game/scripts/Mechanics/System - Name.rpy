    # ----------------------------------------------------------------------------------------------------
    def Update_NameCall(char_id=None, stage=2, old_fname=None, old_lname=None, new_fname=None, new_lname=None):
    # ----------------------------------------------------------------------------------------------------
        for caller in ["hero", "wmom", "wsis", "wgma", "wcou", "waun"]:
            # Check the relationship name from caller to target
            if hasattr(store, f"{caller}_to_{char_id}"):
                current_name = getattr(store, f"{caller}_to_{char_id}")
                updated_name = current_name
                
                # Replace old first name with new first name
                if old_fname and new_fname and old_fname in current_name:
                    updated_name = updated_name.replace(old_fname, new_fname)
                
                # Replace old last name with new last name  
                if old_lname and new_lname and old_lname in current_name:
                    updated_name = updated_name.replace(old_lname, new_lname)
                
                # Update if changed
                if updated_name != current_name:
                    setattr(store, f"{caller}_to_{char_id}", updated_name)
                    setattr(persistent, f"{caller}_to_{char_id}", updated_name)
        return

    # ----------------------------------------------------------------------------------------------------
    def ChaNameCall(caller="hero", target="wsis", nameto="Stepsis", nameabout=None): # Name Call
    # ----------------------------------------------------------------------------------------------------
        setattr(store, f"{caller}_to_{target}", nameto)
        setattr(persistent, str(caller + "_to_" + target), nameto)
        
        if isinstance(nameabout, str):  # Fixed: removed quotes around nameabout
            setattr(store, str(caller + "_about_" + target), nameabout)
            setattr(persistent, str(caller + "_about_" + target), nameabout)

        # Auto-update hero's relationship to wsis based on wsis's relationship to hero
        if caller == "wsis" and target == "hero" and store.hero_to_wsis in ["Lil Sis", "Big Sis"]:
            if wsis_to_hero.startswith("Big"):
                setattr(store, "hero_to_wsis", "Lil Sis")
                setattr(persistent, "hero_to_wsis", "Lil Sis")
            else:
                setattr(store, "hero_to_wsis", "Big Sis")
                setattr(persistent, "hero_to_wsis", "Big Sis")
        
        return

    # ----------------------------------------------------------------------------------------------------
    def ChaNameWrite(char_id="hero", target=None): # Name Writer
    # ----------------------------------------------------------------------------------------------------
        old_fname = getattr(store, f"fname{char_id}", "")

        if char_id in ["wmom", "wsis"]:
            old_lname = getattr(store, "lnamestep", "")
        elif char_id in ["wgma", "wcou", "waun"]:
            old_lname = getattr(store, "lnamerela", "")
        else:
            old_lname = getattr(store, f"lname{char_id}", "")

        # Check if names are placeholders - if so, start with empty default
        default_fname = "" if "?????" in old_fname else old_fname
        default_lname = "" if "?????" in old_lname else old_lname

        # ----------------------------------------------------------------------------------------------------
        if target != 2: # First Name
        # ----------------------------------------------------------------------------------------------------
            if char_id == "hero":
                get_name = renpy.input(renpy.translate_string("What's your First Name?"), default=default_fname, length=12)
            elif char_id.startswith("h"):
                get_name = renpy.input(renpy.translate_string("What's his First Name?"), default=default_fname, length=12)
            elif char_id.startswith("w"):
                get_name = renpy.input(renpy.translate_string("What's her First Name?"), default=default_fname, length=12)
            else:
                get_name = ""

            for buceta in CHAR_IDS:
                if buceta != char_id and getattr(store, f"fname{buceta}", None) == get_name:
                    msg.msg(renpy.translate_string("Name already used in another character"))
                    return

            setattr(store, "fname" + char_id, get_name)
            setattr(persistent, "fname" + char_id, get_name)
            
            if get_name != "" and old_fname != get_name:
                Update_NameCall(char_id, old_fname=old_fname, new_fname=get_name)

        # ----------------------------------------------------------------------------------------------------
        if target != 1: # Last Name
        # ----------------------------------------------------------------------------------------------------
            if char_id == "hero":
                get_name = renpy.input(renpy.translate_string("What's your Last Name?"), default=default_lname, length=12)
            elif char_id.startswith("h"):
                get_name = renpy.input(renpy.translate_string("What's his Last Name?"), default=default_lname, length=12)
            elif char_id.startswith("w"):
                get_name = renpy.input(renpy.translate_string("What's her Last Name?"), default=default_lname, length=12)

            # Update last name
            if char_id in ["wmom", "wsis"]:
                setattr(store, "lnamestep", get_name)
                setattr(persistent, "lnamestep", get_name)
            elif char_id in ["wgma", "wcou", "waun"]:
                setattr(store, "lnamerela", get_name)
                setattr(persistent, "lnamerela", get_name)
            else:
                setattr(store, "lname" + char_id, get_name)
                setattr(persistent, "lname" + char_id, get_name)
            
            if get_name != "" and old_lname != get_name:
                Update_NameCall(char_id, old_lname=old_lname, new_lname=get_name)

        if get_name == "":
            ChaNameGen(char_id=char_id, target=target)

        return

